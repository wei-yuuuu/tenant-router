{
  "name": "tenant-router",
  "version": "0.1.0",
  "description": "Framework-agnostic tenant routing core API.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    }
  },
  "scripts": {
    "test": "node test/tenant-router.test.js",
    "check": "node --check src/index.ts && node --check src/node.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tenant",
    "router",
    "multitenancy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.16"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
